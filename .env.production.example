# Production environment for the single-VM deployment.
#
# Copy to .env.production ON THE SERVER ONLY and fill in real values. That file
# is gitignored: this repository is public, and every value below is either a
# signing key, a database password or a bearer token.
#
#   cp .env.production.example .env.production && nano .env.production
#
# Generate the secrets with:
#   node -e "const{generateKeyPairSync}=require('crypto');const{privateKey,publicKey}=generateKeyPairSync('rsa',{modulusLength:2048});console.log('AUTH_JWT_PRIVATE_KEY='+Buffer.from(privateKey.export({type:'pkcs8',format:'pem'})).toString('base64'));console.log('AUTH_JWT_PUBLIC_KEYS='+Buffer.from(publicKey.export({type:'spki',format:'pem'})).toString('base64'))"
#   openssl rand -base64 32   # AUTH_EMAIL_ENCRYPTION_KEY (must decode to 32 bytes)
#   openssl rand -hex 32      # MARKET_INGESTION_TOKEN
#   openssl rand -hex 16      # POSTGRES_PASSWORD and the per-service passwords

# Which images to run. `dev` is a moving tag the publish workflow repoints at
# every merge, and what the deploy timer follows. To roll back, set this to a
# commit SHA (every published commit keeps its own tag) and run
# `sudo systemctl start tradeiq-deploy.service` — pin it here or the next timer
# run drags you straight back to the branch head.
IMAGE_TAG=dev

# --- Database ---------------------------------------------------------------
# docker/db/init.sql creates the per-service users on FIRST BOOT ONLY, reading
# these. Changing them later does not re-run it; you have to ALTER USER by hand.
POSTGRES_PASSWORD=
MARKET_DATA_DB_PASSWORD=
AUTH_DB_PASSWORD=
ML_DB_PASSWORD=

# --- Signing keys -----------------------------------------------------------
# identity-auth holds the private half and is the only thing that can mint a
# token; market-trading holds the public half and can only verify one. Both
# services refuse to boot with the repository's development pair under
# NODE_ENV=production, so these must be freshly generated.
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PUBLIC_KEYS=

# Encrypts stored email addresses. Only length-validated, so a placeholder here
# is accepted silently — it must be a real random value.
AUTH_EMAIL_ENCRYPTION_KEY=

# --- Ingestion --------------------------------------------------------------
# The bearer token cse-dataset's daily cron presents to
# POST /api/market/internal/v1/ingestions/eod. Set the same value as
# TRADEIQ_INGESTION_TOKEN in the cse-dataset repository's secrets.
MARKET_INGESTION_TOKEN=
