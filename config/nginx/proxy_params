# The Debian nginx package ships a file like this; the official image does not,
# so we carry our own. Without X-Forwarded-Proto the Nest services cannot tell
# that the browser is on HTTPS, and identity-auth will refuse to set a Secure
# refresh cookie.
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_http_version 1.1;
proxy_set_header Connection "";
