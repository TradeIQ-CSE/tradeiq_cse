# PROPOSED schedule, for the platform owner to confirm: 19:30 Asia/Colombo,
# Monday to Friday.
#
# CSE closes at 14:30 SLST. cse-dataset's daily cron starts at 14:45 SLST and
# may run for up to an hour, and GitHub's scheduler can start it late, so the
# day's prices usually reach market-trading by about 16:00. 19:30 leaves
# margin for a slow day without pushing the run into the night. Weekends have
# no new session to predict. A run on a market holiday just re-predicts the
# last session, and the upsert makes that a harmless no-op.
[Unit]
Description=Daily TradeIQ long-trade predictions after the CSE EOD data lands

[Timer]
OnCalendar=Mon..Fri *-*-* 19:30:00 Asia/Colombo
# A daily job, unlike the 5-minute deploy check: if the box was off at 19:30,
# run once when it is back rather than skip a day.
Persistent=true
Unit=tradeiq-ml-long-trade.service

[Install]
WantedBy=timers.target
