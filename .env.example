# TradeIQ local configuration. Copy this file to .env at the repository root.
# Scripts and Compose select variables per service; .env stays untracked.
# Native tools use localhost URLs. Containers use internal Compose addresses.

NODE_ENV=development

# Local database and published ports (docker/db/init.sql creates service users).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
DB_PORT=5432
REDIS_PORT=6379
MARKET_TRADING_PORT=3001
IDENTITY_AUTH_PORT=3002
ML_PREDICTION_PORT=8001
FRONTEND_PORT=5173

# Native connections. Update these URLs if host ports change.
MARKET_DATA_DATABASE_URL=postgresql://market_data:changeme@localhost:5432/market_data
AUTH_DATABASE_URL=postgresql://auth:changeme@localhost:5432/auth
ML_DATABASE_URL=postgresql://ml:changeme@localhost:5432/ml
ML_MARKET_TRADING_API_URL=http://localhost:3001
# Optional batch settings. Empty values select the model owner's defaults.
ML_LONG_TRADE_SYMBOLS=
ML_LONG_TRADE_MIN_HISTORY_BARS=
ML_LONG_TRADE_TRAIN_LOOKBACK_DAYS=
ML_LONG_TRADE_GRID=
ML_LONG_TRADE_N_JOBS=
ML_LONG_TRADE_HTTP_TIMEOUT_SECONDS=
ML_LONG_TRADE_LOG_LEVEL=
DATA_INGESTION_MARKET_DATA_DATABASE_URL=postgresql://market_data:changeme@localhost:5432/market_data
REDIS_URL=redis://localhost:6379

# Update browser origins and public URLs together if ports change.
MARKET_TRADING_CORS_ORIGINS=http://localhost:5173
IDENTITY_AUTH_CORS_ORIGINS=http://localhost:5173
VITE_MARKET_TRADING_API_URL=http://localhost:3001
VITE_IDENTITY_AUTH_API_URL=http://localhost:3002

# Published development-only RSA pair. Production validation rejects this pair.
# Generate a pair for a new deployment:
# node -e "const {generateKeyPairSync}=require('crypto');const {privateKey,publicKey}=generateKeyPairSync('rsa',{modulusLength:2048});console.log('AUTH_JWT_PRIVATE_KEY='+Buffer.from(privateKey.export({type:'pkcs8',format:'pem'})).toString('base64'));console.log('AUTH_JWT_PUBLIC_KEYS='+Buffer.from(publicKey.export({type:'spki',format:'pem'})).toString('base64'))"
AUTH_JWT_PRIVATE_
AUTH_JWT_PUBLIC_

# Development email-encryption key. Keep existing deployment keys unchanged;
# replacing the key makes stored email addresses unreadable.
# Generate a key for a new deployment: openssl rand -base64 32
AUTH_EMAIL_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
AUTH_ACCESS_TOKEN_TTL=5m
AUTH_REFRESH_TOKEN_TTL=15d
AUTH_REFRESH_COOKIE_SECURE=false

# Empty disables machine ingestion locally. Hosted delivery uses the matching
# TRADEIQ_INGESTION_TOKEN secret in the dataset repository.
MARKET_INGESTION_TOKEN=
PUBLIC_API_HOURLY_LIMIT=100

# Empty selects the bundled sample. A local zip, directory or HTTPS URL is accepted.
CSE_DATASET_ARTIFACT=
BACKTEST_MAX_DATE=2025-12-31
