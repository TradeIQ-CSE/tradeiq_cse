# ---------------------------------------------------------------------------
# TradeIQ CSE — root .env, read by docker-compose ONLY (never mounted into any
# service). Copy to .env and fill in real values; .env is gitignored.
#
# Each service owns its own environment: see <service>/.env.example
# (e.g. services/identity-auth/.env.example). Compose injects only the
# variables a service needs, so one service's secrets are never visible to
# another.
# ---------------------------------------------------------------------------

NODE_ENV=development

# ---- Postgres (single shared instance) --------------------------------------
# Superuser for the one Postgres container. Per-service databases and users
# are created by docker/db/init.sql on first boot.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
DB_PORT=5432

# ---- Published service ports -------------------------------------------------
MARKET_TRADING_PORT=3001
IDENTITY_AUTH_PORT=3002
ML_PREDICTION_PORT=8001
FRONTEND_PORT=5173

# ---- identity-auth secrets (injected into that container only) ---------------
JWT_SECRET=changeme

# 32 random bytes, base64 — encrypts stored email addresses (auth-v1.md §5).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_EMAIL_ENCRYPTION_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaShouldChange=

# Compose serves over plain HTTP, where a Secure cookie would be dropped.
AUTH_REFRESH_COOKIE_SECURE=false

# ---- data-ingestion seed bundle (used by the market-data-seed one-shot job) ----
# Leave both empty to load the bundled sample fixture; set a local dir of canonical
# cse-dataset artifacts (company_metadata.csv, daily_ohlcv.csv/.parquet, ...) or a
# URL to a .zip of the same for the full 2017-2025 load.
CSE_SEED_DATA_DIR=
CSE_DATA_SOURCE_URL=

# ---- frontend (build-time API URLs baked into the SPA) -----------------------
VITE_MARKET_TRADING_API_URL=http://localhost:3001
VITE_IDENTITY_AUTH_API_URL=http://localhost:3002
