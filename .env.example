# ---------------------------------------------------------------------------
# TradeIQ CSE — root .env, read by docker-compose ONLY (never mounted into any
# service). Copy to .env and fill in real values; .env is gitignored.
#
# Each service owns its own environment: see <service>/.env.example
# (e.g. services/identity-auth/.env.example). Compose injects only the
# variables a service needs, so one service's secrets are never visible to
# another.
# ---------------------------------------------------------------------------

NODE_ENV=development

# ---- Postgres (single shared instance) --------------------------------------
# Superuser for the one Postgres container. Per-service databases and users
# are created by docker/db/init.sql on first boot.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
DB_PORT=5432

# ---- Published service ports -------------------------------------------------
MARKET_TRADING_PORT=3001
IDENTITY_AUTH_PORT=3002
ML_PREDICTION_PORT=8001
FRONTEND_PORT=5173

# Dedicated machine credential for the cse-dataset EOD push. Generate a long
# random value; leave empty to keep the write API disabled.
MARKET_INGESTION_TOKEN=

# ---- auth keys --------------------------------------------------------------
# Access tokens are RS256 (docs/api/auth-v1.md §2). identity-auth holds the
# private key and is the only thing that can mint a token; market-trading is
# given the public half and can do nothing but check one. They are a pair: the
# public key below must be the public half of the private key below.
#
# The pair below is published in this repository, so it signs nothing anyone
# else cannot also sign. Both services refuse to boot with it once
# NODE_ENV=production. Generate a real pair with:
#   node -e "const {generateKeyPairSync}=require('crypto');const {privateKey,publicKey}=generateKeyPairSync('rsa',{modulusLength:2048});console.log('AUTH_JWT_PRIVATE_KEY='+Buffer.from(privateKey.export({type:'pkcs8',format:'pem'})).toString('base64'));console.log('AUTH_JWT_PUBLIC_KEYS='+Buffer.from(publicKey.export({type:'spki',format:'pem'})).toString('base64'))"
AUTH_JWT_PRIVATE_

# Comma-separated, because a rotation is staged: add the incoming key here and
# deploy, swap AUTH_JWT_PRIVATE_KEY and deploy, then drop the outgoing key once
# the last token it signed has expired (AUTH_ACCESS_TOKEN_TTL).
AUTH_JWT_PUBLIC_

# 32 random bytes, base64 — encrypts stored email addresses (auth-v1.md §5).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_EMAIL_ENCRYPTION_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaShouldChange=

# Compose serves over plain HTTP, where a Secure cookie would be dropped.
AUTH_REFRESH_COOKIE_SECURE=false

IDENTITY_AUTH_CORS_ORIGINS=http://localhost:5173

# ---- data-ingestion release import (the market-data-seed one-shot job) --------
# Empty loads the bundled sample. For the 2017-2025 history, set a cse-dataset
# release URL, e.g.
# https://github.com/TradeIQ-CSE/cse-dataset/releases/download/dataset-2025-12-31.1/cse-dataset-2025-12-31.1.zip
CSE_DATASET_ARTIFACT=

# ---- frontend (build-time API URLs baked into the SPA) -----------------------
VITE_MARKET_TRADING_API_URL=http://localhost:3001
VITE_IDENTITY_AUTH_API_URL=http://localhost:3002
