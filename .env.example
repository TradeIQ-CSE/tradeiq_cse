# ---------------------------------------------------------------------------
# TradeIQ CSE — example environment variables
# Copy to .env and fill in real values. .env is gitignored.
# ---------------------------------------------------------------------------

# ---- General ----------------------------------------------------------
NODE_ENV=development

# ---- market-trading service (NestJS) -----------------------------------
MARKET_TRADING_PORT=3001
MARKET_DATA_DB_HOST=localhost
MARKET_DATA_DB_PORT=5433
MARKET_DATA_DB_NAME=market_data
MARKET_DATA_DB_USER=market_data
MARKET_DATA_DB_PASSWORD=changeme
MARKET_DATA_DATABASE_URL=postgresql://market_data:changeme@localhost:5433/market_data

# ---- identity-auth service (NestJS) -------------------------------------
IDENTITY_AUTH_PORT=3002
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5434
AUTH_DB_NAME=auth
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=changeme
AUTH_DATABASE_URL=postgresql://auth:changeme@localhost:5434/auth
JWT_SECRET=changeme

# ---- ml-prediction service (FastAPI) -------------------------------------
ML_PREDICTION_PORT=8001
ML_DB_HOST=localhost
ML_DB_PORT=5435
ML_DB_NAME=ml
ML_DB_USER=ml
ML_DB_PASSWORD=changeme
ML_DATABASE_URL=postgresql://ml:changeme@localhost:5435/ml

# ---- data-pipeline (scheduled job, Python) -------------------------------
# Pipeline writes into market_data via the market-trading service's DB.
DATA_PIPELINE_MARKET_DATA_DATABASE_URL=postgresql://market_data:changeme@localhost:5433/market_data
CSE_DATA_SOURCE_URL=

# ---- Redis (rate limiting + reference cache only) ------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- apps/web (Vite SPA) -------------------------------------------------
VITE_MARKET_TRADING_API_URL=http://localhost:3001
VITE_IDENTITY_AUTH_API_URL=http://localhost:3002
