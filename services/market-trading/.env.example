# ---------------------------------------------------------------------------
# market-trading — environment owned by this service only.
# Copy to .env (gitignored) when running outside Docker. Never share these
# values with other services; in deployments each service gets its own secrets.
# ---------------------------------------------------------------------------

MARKET_TRADING_PORT=3001

# Comma-separated browser origins allowed to call this API (CORS).
# Defaults to the Vite dev server when unset.
MARKET_TRADING_CORS_ORIGINS=http://localhost:5173

# Single shared Postgres instance; market-trading owns the `market_data`
# database exclusively. Local dev credentials match docker/db/init.sql.
MARKET_DATA_DATABASE_URL=postgresql://market_data:changeme@localhost:5432/market_data
