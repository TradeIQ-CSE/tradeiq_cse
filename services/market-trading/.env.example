# ---------------------------------------------------------------------------
# market-trading — environment owned by this service only.
# Copy to .env (gitignored) when running outside Docker. Never share these
# values with other services; in deployments each service gets its own secrets.
# ---------------------------------------------------------------------------

MARKET_TRADING_PORT=3001

# Comma-separated browser origins allowed to call this API (CORS).
# Defaults to the Vite dev server when unset.
MARKET_TRADING_CORS_ORIGINS=http://localhost:5173

# Single shared Postgres instance; market-trading owns recurring access to the
# `market_data` database. Controlled seed/import jobs are direct-write
# exceptions. Local dev credentials match docker/db/init.sql.
MARKET_DATA_DATABASE_URL=postgresql://market_data:changeme@localhost:5432/market_data
MARKET_INGESTION_TOKEN=

# Backs the hourly per-key rate-limit counters for the public developer API
# (SRS 3.6.1). Matches docker-compose.yml's redis service for local dev; a
# Redis that is unreachable at runtime does not take the API down (fail open,
# docs/adr/0010-public-developer-api.md) but a missing/malformed URL still
# fails boot.
REDIS_URL=redis://localhost:6379

# The public developer API's hourly per-key rate limit (SRS 3.1.3.3, 3.5.4).
# Optional; defaults to 100 when unset.
PUBLIC_API_HOURLY_LIMIT=100

# The public keys access tokens are verified against — comma-separated,
# base64-encoded SPKI PEMs. identity-auth holds the private half, so nothing in
# this service's environment can mint a token. Published here, so it is
# rejected at boot when NODE_ENV=production.
#
# Comma-separated because a rotation is staged: the incoming key is added and
# accepted before identity-auth signs with it, and the outgoing one is dropped
# once the last token it signed has expired.
AUTH_JWT_PUBLIC_
