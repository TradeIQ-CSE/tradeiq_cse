# The scheduled long-trade job (app/long_trade): runs once and exits. The API
# image (Dockerfile) installs no dependency groups, so pandas, scikit-learn
# and XGBoost live only in this image; build context is the repository root.
FROM python:3.12-slim AS base
WORKDIR /app

FROM base AS build
RUN pip install --no-cache-dir uv
# Compile bytecode now: the runtime user cannot write __pycache__ into /app.
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_NO_CACHE=1
# Dependencies first, from the lockfile, so a code change does not reinstall
# them. --frozen: the image gets exactly what CI tested, never a fresh resolve.
COPY services/ml-prediction/pyproject.toml services/ml-prediction/uv.lock ./
RUN uv sync --frozen --no-dev --group long-trade --no-install-project
COPY services/ml-prediction .
RUN uv sync --frozen --no-dev --group long-trade

# uv itself stays behind in the build stage; the job only needs the venv.
FROM base AS runtime
ENV PYTHONUNBUFFERED=1 PATH="/app/.venv/bin:$PATH"
RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin tradeiq
COPY --from=build /app /app
USER tradeiq
CMD ["python", "-m", "app.long_trade.main"]
