# Build from services/ml-prediction, like the API image. Numeric dependencies
# belong only to this batch image; its default command runs once and exits.
FROM python:3.12-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.12.23 /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_PYTHON_DOWNLOADS=never UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --group long-trade --no-install-project
COPY app ./app
RUN uv sync --frozen --no-dev --group long-trade --no-editable

FROM python:3.12-slim AS runtime
ENV PYTHONUNBUFFERED=1 PATH="/app/.venv/bin:$PATH"
WORKDIR /app
RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin tradeiq
COPY --from=build /app/.venv ./.venv
USER tradeiq
CMD ["python", "-m", "app.long_trade.main"]
