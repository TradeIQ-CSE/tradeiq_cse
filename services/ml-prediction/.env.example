# ---------------------------------------------------------------------------
# ml-prediction — environment owned by this service only.
# Copy to .env (gitignored) when running outside Docker. Never share these
# values with other services; in deployments each service gets its own secrets.
# ---------------------------------------------------------------------------

ML_PREDICTION_PORT=8001

# Single shared Postgres instance; ml-prediction owns the `ml` database
# exclusively. Local dev credentials match docker/db/init.sql.
ML_DATABASE_URL=postgresql://ml:changeme@localhost:5432/ml
