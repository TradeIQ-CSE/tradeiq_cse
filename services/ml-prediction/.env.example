# ---------------------------------------------------------------------------
# ml-prediction — environment owned by this service only.
# Copy to .env (gitignored) when running outside Docker. Never share these
# values with other services; in deployments each service gets its own secrets.
# ---------------------------------------------------------------------------

ML_PREDICTION_PORT=8001

# Single shared Postgres instance; ml-prediction owns the `ml` database
# exclusively. Local dev credentials match docker/db/init.sql.
ML_DATABASE_URL=postgresql://ml:changeme@localhost:5432/ml

# ---- Long-trade job (python -m app.long_trade.main) -------------------------
# market-trading's base URL; every price comes over REST, never from the
# market_data database. Inside Compose: http://market-trading:3001.
ML_MARKET_TRADING_API_URL=http://localhost:3001

# Optional. Empty means the default; see services/ml-prediction/README.md.
# Comma-separated symbols to run, e.g. COMB.N0000,JKH.N0000 (default: every
# security with enough recent history).
ML_LONG_TRADE_SYMBOLS=
# Stocks with fewer daily bars are skipped (default 400).
ML_LONG_TRADE_MIN_HISTORY_BARS=
# Train on the last N calendar days only (default: all history).
ML_LONG_TRADE_TRAIN_LOOKBACK_DAYS=
# JSON grid override, one list per parameter (default: the committed 27-config
# grid), e.g.
# {"take_profit_pct":[0.01],"stop_loss_pct":[0.005],"horizon_bars":[24],"test_days":[30]}
ML_LONG_TRADE_GRID=
# XGBoost / BLAS threads (default 1: the production box has 2 vCPUs to share).
ML_LONG_TRADE_N_JOBS=
# Per-request timeout to market-trading, seconds (default 30).
ML_LONG_TRADE_HTTP_TIMEOUT_SECONDS=
# DEBUG | INFO | WARNING | ERROR (default INFO).
ML_LONG_TRADE_LOG_LEVEL=
