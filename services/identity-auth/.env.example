# ---------------------------------------------------------------------------
# identity-auth — environment owned by this service only.
# Copy to .env (gitignored) when running outside Docker. Never share these
# values with other services; in deployments each service gets its own secrets.
# ---------------------------------------------------------------------------

IDENTITY_AUTH_PORT=3002

# Single shared Postgres instance; identity-auth owns the `auth` database
# exclusively. Local dev credentials match docker/db/init.sql.
AUTH_DATABASE_URL=postgresql://auth:changeme@localhost:5432/auth

JWT_SECRET=changeme
