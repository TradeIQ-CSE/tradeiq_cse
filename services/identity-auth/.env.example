# ---------------------------------------------------------------------------
# identity-auth — environment owned by this service only.
# Copy to .env (gitignored) when running outside Docker. Never share these
# values with other services; in deployments each service gets its own secrets.
# ---------------------------------------------------------------------------

IDENTITY_AUTH_PORT=3002

# Single shared Postgres instance; identity-auth owns the `auth` database
# exclusively. Local dev credentials match docker/db/init.sql.
AUTH_DATABASE_URL=postgresql://auth:changeme@localhost:5432/auth

# The RS256 private key access tokens are signed with, base64-encoded PKCS#8
# PEM. This service is the only one that holds it; verifiers get the public
# half. Published here, so it is rejected at boot when NODE_ENV=production.
#   node -e "const {generateKeyPairSync}=require('crypto');const {privateKey,publicKey}=generateKeyPairSync('rsa',{modulusLength:2048});console.log('AUTH_JWT_PRIVATE_KEY='+Buffer.from(privateKey.export({type:'pkcs8',format:'pem'})).toString('base64'));console.log('AUTH_JWT_PUBLIC_KEYS='+Buffer.from(publicKey.export({type:'spki',format:'pem'})).toString('base64'))"
AUTH_JWT_PRIVATE_

# Optional, and only used mid-rotation: extra public keys GET /auth/me will
# still accept. The signing key's own public half is always accepted without
# being listed here.
# AUTH_JWT_PUBLIC_KEYS=

# docs/api/auth-v1.md §8. The access token cannot be revoked, so it is kept
# short; the refresh token can be, so it is allowed to live much longer.
AUTH_ACCESS_TOKEN_TTL=5m
AUTH_REFRESH_TOKEN_TTL=15d

# 32 random bytes, base64. Encrypts auth.users.email_encrypted and keys the
# HMAC behind email_hash. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing this makes every existing stored email unreadable.
AUTH_EMAIL_ENCRYPTION_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaShouldChange=

# Browsers drop a Secure cookie over plain HTTP, so local development turns it
# off. Must stay true anywhere the app is actually deployed.
AUTH_REFRESH_COOKIE_SECURE=false

# Base URL of the market-trading service. Paper-order execution fetches its
# EOD quote over REST; identity-auth never connects to the market_data
# database. Inside Docker Compose this is http://market-trading:3001.
MARKET_TRADING_URL=http://localhost:3001

# How long to wait for an execution quote before failing the order with
# 503 DEPENDENCY_UNAVAILABLE.
MARKET_TRADING_TIMEOUT_MS=3000
