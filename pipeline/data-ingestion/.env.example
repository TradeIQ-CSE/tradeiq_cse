# ---------------------------------------------------------------------------
# data-ingestion — environment owned by this job only.
# Copy to .env (gitignored) when running outside Docker. Never share these
# values with other services; in deployments each service gets its own secrets.
# ---------------------------------------------------------------------------

# Legacy/local seed and import jobs may write directly to the `market_data`
# database owned by market-trading. Recurring EOD delivery uses the ingestion
# API. Local dev credentials match docker/db/init.sql.
DATA_INGESTION_MARKET_DATA_DATABASE_URL=postgresql://market_data:changeme@localhost:5432/market_data

# Release to import (python -m data_ingestion.release_import): a release zip,
# an unpacked directory, or an https:// URL. Empty loads the bundled sample.
CSE_DATASET_ARTIFACT=
