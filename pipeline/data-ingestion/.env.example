# ---------------------------------------------------------------------------
# data-ingestion — environment owned by this job only.
# Copy to .env (gitignored) when running outside Docker. Never share these
# values with other services; in deployments each service gets its own secrets.
# ---------------------------------------------------------------------------

# The job writes end-of-day data into the `market_data` database owned by the
# market-trading service. Local dev credentials match docker/db/init.sql.
DATA_INGESTION_MARKET_DATA_DATABASE_URL=postgresql://market_data:changeme@localhost:5432/market_data

CSE_DATA_SOURCE_URL=
